# Supabase (projeto fvgbbixxcapltudonxqx, schema "sales")
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel AI Gateway
AI_GATEWAY_API_KEY=

# Cron routes (app/api/cron/*) — única autenticação dessas rotas (D-034).
# Valor aleatório de >=32 caracteres. Em Production a Vercel injeta
# automaticamente `Authorization: Bearer $CRON_SECRET` nas requests de Cron
# quando esta env var existe no projeto; sem ela a rota responde 401 a cada
# execução agendada.
CRON_SECRET=

# Seed de demonstração (opcional, só dev) — e-mail de uma conta existente
# para vincular como owner da org demo; sem isso a org demo não aparece no app.
SEED_DEMO_OWNER_EMAIL=

# Gerador de types (ferramenta de desenvolvimento, D-042) — personal access
# token do Supabase (sbp_...), usado por `npm run gen:types` e `npm run
# types:check` para baixar os tipos do schema `sales` pela Management API.
# NÃO é env de aplicação: não vai para a Vercel, não entra em
# `lib/env.server.ts`, nenhum código de runtime a lê, não é `service_role`.
# Gere em https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
